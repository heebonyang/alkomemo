rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    // 구글 계정 이메일 (소문자). 초대장은 이 이메일로 찾음
    function myEmail() {
      return request.auth.token.email.lower();
    }
    // 초대 메일 확인: 인증된 이메일이거나, 구글 로그인(메일 주소를 구글이 보증)일 때.
    // 구글 계정이라도 gmail 이 아닌 주소(네이버 등)는 Firebase 가 email_verified=false 로 주기 때문
    function emailTrusted() {
      return request.auth.token.email_verified == true
        || request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function spaceData(sid) {
      return get(/databases/$(database)/documents/spaces/$(sid)).data;
    }
    function isMember(sid) {
      return signedIn() && request.auth.uid in spaceData(sid).members;
    }

    // 이름 표시용 프로필: 로그인한 사람은 읽고, 자기 것만 씀.
    // 닉네임(nick)을 적으려면 그 닉네임을 nicknames 에 내 것으로 먼저 잡아 둬야 함 → 중복 불가
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid && (
        !('nick' in request.resource.data)
        || request.resource.data.nick == ''
        || get(/databases/$(database)/documents/nicknames/$(request.resource.data.nick.lower())).data.uid == uid
      );
    }

    // 닉네임 자리 잡기: 문서 id = 소문자 닉네임. 이미 있으면 새로 만들 수 없음(덮어쓰기 불가) → 먼저 잡은 사람 것
    match /nicknames/{key} {
      allow read: if signedIn();
      allow create: if signedIn()
        && key.matches('^[가-힣a-z0-9_][가-힣a-z0-9_.-]{1,15}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // 노트북: 멤버만 읽고 고침
    match /spaces/{sid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      // 만들 때는 만든 사람 혼자 멤버
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid];
      // 멤버는 이름 바꾸기·나가기 등을 할 수 있고 (다른 멤버를 빼는 것은 안 됨, 자기 자신만 나갈 수 있음),
      // 초대받은 사람은 자기 자신을 멤버로 추가하는 것만 할 수 있음.
      // 2명 이상이 함께 쓰는 동안에는 공유를 끌 수 없음 (다른 멤버가 다 나가 혼자 남으면 다시 끌 수 있음)
      allow update: if signedIn() && (
        (
          request.auth.uid in resource.data.members
          && resource.data.members.toSet().difference(request.resource.data.members.toSet()).hasOnly([request.auth.uid])
          && !(request.resource.data.members.size() > 1 && request.resource.data.get('shared', true) == false)
        )
        || (
          emailTrusted()
          && exists(/databases/$(database)/documents/invites/$(sid + '__' + myEmail()))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberEmails'])
          && request.resource.data.members.toSet().difference(resource.data.members.toSet()) == [request.auth.uid].toSet()
          && resource.data.members.toSet().difference(request.resource.data.members.toSet()).size() == 0
        )
      );
      // 삭제는 만든 사람만
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      // 노트북 안의 노트·프로젝트·알림(notices) 등 (하위 경로가 한 단계 이상일 때만.
      // {document=**} 만 쓰면 노트북 문서 자체에도 적용돼서 멤버 누구나 지울 수 있게 됨)
      match /{sub}/{document=**} {
        allow read, write: if isMember(sid) && sub != 'members';
      }
      // 멤버 연락처(이메일): 멤버끼리만 보임. 각자 자기 것만 적고, 이메일은 로그인한 구글 계정 그대로
      match /members/{mid} {
        allow read, delete: if isMember(sid);
        allow create, update: if isMember(sid) && mid == request.auth.uid
          && request.resource.data.keys().hasOnly(['email'])
          && request.resource.data.email == myEmail();
      }
    }

    // 초대장: 문서 id 는 "<노트북 id>__<이메일>"
    match /invites/{id} {
      allow read: if signedIn() && (
        (emailTrusted() && resource.data.email == myEmail())
        || isMember(resource.data.spaceId)
      );
      allow create: if isMember(request.resource.data.spaceId)
        && id == request.resource.data.spaceId + '__' + request.resource.data.email
        && request.resource.data.invitedBy == request.auth.uid;
      allow update: if isMember(resource.data.spaceId);
      allow delete: if signedIn() && (
        (emailTrusted() && resource.data.email == myEmail())
        || isMember(resource.data.spaceId)
      );
    }

    // 나만 보는 데이터('노트' 노트북의 노트, 탭 순서·읽음 표시, 알림 기록): 본인만
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
